# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# FFmpeg.wasm core is copied here by scripts/setup-ffmpeg.mjs (32 MB binary).
# Only the patched library bundle is committed: without it a fresh clone cannot
# run `npm install`'s postinstall step.
/public/ffmpeg/*
!/public/ffmpeg/ffmpeg.js
!/public/ffmpeg/.gitkeep

# Vision runtime + face model are generated by scripts/setup-models.mjs.
# The face model is committed so a fresh clone can always detect faces.
/public/models/*
!/public/models/blaze_face_short_range.tflite
!/public/models/test-face.jpg

# TypeScript incremental build info
*.tsbuildinfo
smoke-report.json
smoke-ai-report.json
